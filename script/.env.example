# Token Vesting - Environment Example
# Copy to .env and fill in values, then export into your shell before running forge script
# Example to load:
#   set -a
#   source .env
#   set +a

# --- RPC and Signer ---
# RPC endpoint used by forge when broadcasting
RPC_URL=
# Deployer private key (hex, 0x-prefixed). Also used by forge --private-key.
PRIVATE_KEY=

# --- Deployment constructor args ---
# ERC20 token address for vesting; can be left empty (address(0)) and set later via setToken()
VESTING_TOKEN=
# Address granted UPDATER_ROLE (defaults to deployer if left empty)
VESTING_UPDATER=
# Address granted PAUSER_ROLE (defaults to deployer if left empty)
VESTING_PAUSER=

# --- Optional: vesting parameters (auto-set if any provided) ---
# If any of START_TIME, DURATION, or INIT_BPS is non-empty, the script will attempt
# to call setVestingParameters(initBps, startTime, duration). START_TIME and DURATION
# must both be non-zero in that case; INIT_BPS can be zero.
INIT_BPS=
START_TIME=
DURATION=
