# Token Vesting - Environment Example
# Copy to .env and fill in values, then export into your shell before running forge script
# Example to load:
#   set -a; source script/.env; set +a

# --- RPC and Signer ---
# RPC endpoint used by forge when broadcasting
RPC_URL=
# Deployer private key (hex, 0x-prefixed). Also used by forge --private-key.
PRIVATE_KEY=

# --- Contract Verification ---
# Etherscan API key for contract verification (required for --verify flag)
ETHERSCAN_API_KEY=

# --- Config-driven deployment ---
# Path to vesting/council JSON config
VESTING_CONFIG=